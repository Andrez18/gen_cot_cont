# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin
ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Subscription
NEXT_PUBLIC_SUBSCRIPTION_PRICE_COP=30000
SUBSCRIPTION_PRICE_COP=30000

# Nequi (datos del paywall)
NEXT_PUBLIC_NEQUI_NUMBER=300 000 0000
NEXT_PUBLIC_NEQUI_HOLDER=Tu Nombre

# Site
NEXT_PUBLIC_SITE_URL=https://cotifactura.vercel.app

# Email (Gmail SMTP - opcional)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# 2FA / MTA (opcional — solo si habilitas 2FA para el admin)
# Genera una clave de 32 bytes en hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=your-64-char-hex-key

# Web Push (VAPID — para notificaciones push del PWA)
# Genera keys con: node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k.publicKey);console.log(k.privateKey)"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:your-email@example.com
